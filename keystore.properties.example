# Copie este arquivo para keystore.properties e preencha SOMENTE no seu computador.
# Nunca envie keystore.properties, o arquivo .jks, .keystore, .pem ou senhas ao GitHub.
# Para o Google Play, use uma upload key separada e habilite Play App Signing.

storeFile=/caminho/absoluto/para/itasuper-upload-key.jks
storePassword=SUBSTITUA_POR_UMA_SENHA_FORTE
keyAlias=itasuper_upload
