<?xml version="1.0" encoding="utf-8"?>
<!-- Backup rules: exclui a sessão criptografada do backup automático.
     As chaves do Android Keystore não sobrevivem a backup/restore,
     então os dados criptografados seriam ilegíveis no novo aparelho —
     e não devem ser copiados. Demais prefs (carrinho etc.) seguem o padrão. -->
<full-backup-content>
    <exclude domain="sharedpref" path="itasuper_secure_session.xml"/>
</full-backup-content>
