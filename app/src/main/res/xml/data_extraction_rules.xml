<?xml version="1.0" encoding="utf-8"?>
<!-- Data extraction rules (API 31+): exclui a sessão criptografada do
     backup em nuvem e da transferência entre aparelhos.
     As chaves do Android Keystore não sobrevivem a backup/restore,
     então os dados criptografados seriam ilegíveis no novo aparelho. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="itasuper_secure_session"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="itasuper_secure_session"/>
    </device-transfer>
</data-extraction-rules>
